From a48245f408539b961430f40b893f03d6d513d1db Mon Sep 17 00:00:00 2001
From: 23rd <23rd@vivaldi.net>
Date: Thu, 29 Oct 2026 19:38:37 +0000
Subject: [PATCH 13/17] Fixed Schannel credentials on Windows versions before

---
 src/plugins/tls/schannel/qtls_schannel.cpp | 24 ++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/plugins/tls/schannel/qtls_schannel.cpp b/src/plugins/tls/schannel/qtls_schannel.cpp
index c5fc3023..19cd934f 100644
--- a/src/plugins/tls/schannel/qtls_schannel.cpp
+++ b/src/plugins/tls/schannel/qtls_schannel.cpp
@@ -1160,6 +1160,30 @@ bool TlsCryptographSchannel::acquireCredentialsHandle()
                                            &expiration // ptsExpir
     );
 
+    if (status == SEC_E_UNKNOWN_CREDENTIALS) {
+        // SCH_CREDENTIALS with TLS_PARAMETERS is rejected by Schannel on
+        // versions older than Windows 10 1903; retry with the legacy
+        // SCHANNEL_CRED struct, which is understood since Windows XP.
+        SCHANNEL_CRED legacyCredentials = {};
+        legacyCredentials.dwVersion = SCHANNEL_CRED_VERSION;
+        legacyCredentials.cCreds = certsCount;
+        legacyCredentials.paCred = const_cast<PCCERT_CONTEXT *>(&localCertificate);
+        legacyCredentials.grbitEnabledProtocols = protocols & ~SP_PROT_TLS1_3;
+        legacyCredentials.dwFlags = SCH_CRED_REVOCATION_CHECK_CHAIN_EXCLUDE_ROOT
+                | defaultCredsFlag();
+
+        status = AcquireCredentialsHandle(nullptr, // pszPrincipal (unused)
+                                          const_cast<wchar_t *>(UNISP_NAME), // pszPackage
+                                          isClient ? SECPKG_CRED_OUTBOUND : SECPKG_CRED_INBOUND, // fCredentialUse
+                                          nullptr, // pvLogonID (unused)
+                                          &legacyCredentials, // pAuthData
+                                          nullptr, // pGetKeyFn (unused)
+                                          nullptr, // pvGetKeyArgument (unused)
+                                          &credentialHandle, // phCredential
+                                          &expiration // ptsExpir
+        );
+    }
+
 #ifdef QT_WIN_SERVER_2016_COMPAT
     if (status == SEC_E_UNKNOWN_CREDENTIALS) {
         if (!ciphers.isEmpty()) {
