Subject: [PATCH 15/17] Adapt Win7 swapchain path to 6.12 render target data.

---
 src/gui/rhi/qrhid3d11.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/gui/rhi/qrhid3d11.cpp b/src/gui/rhi/qrhid3d11.cpp
index 2b784388..b97e0780 100644
--- a/src/gui/rhi/qrhid3d11.cpp
+++ b/src/gui/rhi/qrhid3d11.cpp
@@ -5585,8 +5585,7 @@ bool QD3D11SwapChain::createOrResizeWin7()
     rtD->d.pixelSize = pixelSize;
     rtD->d.dpr = float(window->devicePixelRatio());
     rtD->d.sampleCount = int(sampleDesc.Count);
-    rtD->d.colorAttCount = 1;
-    rtD->d.dsAttCount = m_depthStencil ? 1 : 0;
+    rtD->d.views.setFrom(1, &backBufferRtv, ds ? ds->dsv : nullptr);
 
     if (rhiD->rhiFlags.testFlag(QRhi::EnableTimestamps))
         timestamps.prepare(rhiD);
