+            {
+                return reinterpret_cast<QFunctionPointer>(::eglGetProcAddress(procname));
+            }
+            EGLint eglGetError() override {
+                return ::eglGetError();
+            }
+        };
+        static DirectFunctions s_func;
+        return &s_func;
+    } else {
