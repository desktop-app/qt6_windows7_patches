Subject: [PATCH] Guard a missing swap chain in the ANGLE clear path

Swap-chain creation can fail while creating or replacing a device. Avoid
calling clearSurface with no swap chain before the normal flush can retry.

diff --git a/src/gui/painting/qbackingstoredefaultcompositor.cpp b/src/gui/painting/qbackingstoredefaultcompositor.cpp
--- a/src/gui/painting/qbackingstoredefaultcompositor.cpp
+++ b/src/gui/painting/qbackingstoredefaultcompositor.cpp
@@ -475,7 +475,7 @@ QBackingStoreDefaultCompositor::clearSurface(QRhi *rhi,
                                              QRhiSwapChain *swapchain, QWindow *window,
                                              const QColor &clearColor)
 {
-    if (!rhi)
+    if (!rhi || !swapchain)
         return QPlatformBackingStore::FlushFailed;
 
     if (!m_rhi) {
